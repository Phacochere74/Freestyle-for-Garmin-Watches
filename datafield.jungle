# Projet Connect IQ : le CHAMP DE DONNEES (affiche pendant une activite).
#
# Application distincte, avec son propre stockage : Connect IQ isole les
# applications les unes des autres. Les identifiants sont en revanche partages,
# puisque source-common/Credentials.mc est compile dans les deux.
project.manifest = manifest-datafield.xml
base.sourcePath = source-common;source-datafield
